  button.btn[aria-pressed="true"] {
    border-color: var(--check);
    color: var(--check);
  }

  /* 辨識結果：小字、低調。 */
  .seen {
    padding: 0 10px 6px;
    color: var(--ash);
    font: 400 11px/1.35 var(--font-mono);
  }

  .seen-toggle {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ash);
    font: 500 10.5px/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .seen-toggle:hover {
    color: var(--bone);
  }

  .seen-list {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1px 8px;
    margin: 3px 0 0;
    padding: 4px 6px;
    border: 1px solid var(--iron);
    border-radius: 4px;
    background: color-mix(in srgb, var(--slab) 70%, transparent);
  }

  .seen-list dt {
    color: var(--teal);
    white-space: nowrap;
  }

  .seen-list dd {
    margin: 0;
    min-width: 0;
    color: var(--chalk);
    overflow-wrap: anywhere;
  }

  [hidden] {
    display: none !important;
  }
